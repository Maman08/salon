# ─── PRODUCTION Environment (Hostinger VPS — self-contained) ──────────────────
# Copy this to .env.prod and fill in real values:   cp .env.prod.example .env.prod
# NEVER commit .env.prod to git!
# ──────────────────────────────────────────────────────────────────────────────

# ── Postgres (runs as the `db` service in docker-compose.prod.yml) ────────────
POSTGRES_USER=grenix
POSTGRES_PASSWORD=<GENERATE_A_STRONG_DB_PASSWORD>
POSTGRES_DB=grenix
# Must match the three values above. Host is the compose service name `db`.
DATABASE_URL=postgresql+asyncpg://grenix:<SAME_DB_PASSWORD>@db:5432/grenix

# ── JWT (CHANGE THIS — use: openssl rand -hex 32) ────────────────────────────
JWT_SECRET_KEY=<GENERATE_A_RANDOM_64_CHAR_HEX_STRING>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Storage (MinIO — runs as the `minio` service, S3-compatible) ─────────────
# S3_ENDPOINT_URL = INTERNAL docker address the backend uploads to.
# S3_PUBLIC_URL   = PUBLIC address browsers load images from (via Nginx).
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=grenixadmin
S3_SECRET_KEY=<GENERATE_A_STRONG_MINIO_PASSWORD>
S3_BUCKET_NAME=grenix-media
S3_REGION=ap-south-1
S3_PUBLIC_URL=https://media.grenix.store

# ── Razorpay (leave blank for first deploy; add live keys later) ─────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
CORS_ORIGINS=https://grenix.store,https://www.grenix.store

# ── Frontend API URL (baked into the JS bundle at build time) ────────────────
NEXT_PUBLIC_API_URL=https://api.grenix.store/api/v1
